    <!-- SCRIPT ENGINE -->
    <script>
        // --- GAMIFICATION HUD ---
        let xp = 0; let level = 1;
        function addXP(amount) {
            xp += amount;
            document.getElementById('xp-counter').innerText = xp;
            if (xp >= level * 800) {
                level++;
                document.getElementById('level').innerText = level;
            }
        }

        // --- THEME ENGINE WITH TIMER CONTROLS ---
        const themes = [
            'theme-cyberpunk', 'theme-matrix', 'theme-synthwave', 
            'theme-deepsea', 'theme-emerald', 'theme-crimson', 'theme-violet'
        ];
        let currentThemeIdx = 0;
        let timerSeconds = 30;
        let isTimerRunning = true;
        let timerInterval = null;

        function applyTheme(idx) {
            document.body.className = '';
            currentThemeIdx = (idx + themes.length) % themes.length;
            document.body.classList.add(themes[currentThemeIdx]);

            // Flash effect
            const flash = document.getElementById('flash');
            flash.classList.add('flash-active');
            setTimeout(() => flash.classList.remove('flash-active'), 250);
        }

        function nextTheme() {
            timerSeconds = 30;
            applyTheme(currentThemeIdx + 1);
        }

        function prevTheme() {
            timerSeconds = 30;
            applyTheme(currentThemeIdx - 1);
        }

        function toggleTimer() {
            isTimerRunning = !isTimerRunning;
            const btn = document.getElementById('timer-toggle-btn');
            if (isTimerRunning) {
                btn.innerHTML = '<i class="fas fa-pause"></i>';
                btn.title = "Pause Theme Timer";
            } else {
                btn.innerHTML = '<i class="fas fa-play"></i>';
                btn.title = "Play Theme Timer";
            }
        }

        function startThemeTimer() {
            timerInterval = setInterval(() => {
                if (isTimerRunning) {
                    timerSeconds--;
                    document.getElementById('time-left').innerText = timerSeconds;
                    document.getElementById('timer-fill').style.width = (timerSeconds / 30 * 100) + '%';

                    if (timerSeconds <= 0) {
                        timerSeconds = 30;
                        nextTheme();
                    }
                }
            }, 1000);
        }

        // --- AUDIO PLAYER (MUSIC ONLY, NO SFX) ---
        const audio = document.getElementById('bg-music');
        let isPlaying = false;

        function toggleAudio() {
            const btn = document.getElementById('play-btn');
            if (isPlaying) {
                audio.pause();
                btn.innerHTML = '<i class="fas fa-play"></i>';
            } else {
                audio.play();
                btn.innerHTML = '<i class="fas fa-pause"></i>';
            }
            isPlaying = !isPlaying;
        }

        function changeVolume() {
            audio.volume = document.getElementById('vol-slider').value;
        }

        // --- CALCULATOR LOGIC ---
        function loadLecturePreset() {
            document.getElementById('assetVal').value = 200000;
            document.getElementById('efVal').value = 0.25;
            document.getElementById('aroVal').value = 0.4;
            calculateFinancialRisk();
            addXP(15);
        }

        function calculateFinancialRisk() {
            let asset = parseFloat(document.getElementById('assetVal').value);
            let ef = parseFloat(document.getElementById('efVal').value);
            let aro = parseFloat(document.getElementById('aroVal').value);

            if (isNaN(asset) || isNaN(ef) || isNaN(aro)) return;

            let sle = asset * ef;
            let ale = sle * aro;

            let outBox = document.getElementById('calc-out');
            outBox.style.display = 'block';
            outBox.innerHTML = `SLE = $${sle.toLocaleString()} <br> ALE = $${ale.toLocaleString()} / year`;
            addXP(25);
        }

        // --- QUIZ ENGINE ---
        let currentQ = 1;
        function evalQuiz(qId, elem, isCorrect) {
            let parent = document.getElementById(qId);
            let options = parent.querySelectorAll('.quiz-option');
            options.forEach(opt => opt.style.pointerEvents = 'none');

            if (isCorrect) {
                elem.classList.add('correct');
                addXP(100);
            } else {
                elem.classList.add('wrong');
                options.forEach(opt => {
                    if (opt.getAttribute('onclick').includes('true')) opt.classList.add('correct');
                });
            }

            parent.querySelector('.quiz-feedback').style.display = 'block';

            if (currentQ < 10) {
                document.getElementById('next-q-btn').style.display = 'block';
            } else {
                document.getElementById('quiz-done').style.display = 'block';
                addXP(500);
            }
        }

        function nextQuizStep() {
            document.getElementById('q' + currentQ).style.display = 'none';
            currentQ++;
            document.getElementById('q' + currentQ).style.display = 'block';
            document.getElementById('next-q-btn').style.display = 'none';
        }

        // --- BACKGROUND CANVAS ANIMATION ---
        const canvas = document.getElementById('bg-canvas');
        const ctx = canvas.getContext('2d');
        let width, height;

        function resizeCanvas() {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resizeCanvas);
        resizeCanvas();

        let particles = Array.from({ length: 80 }, () => ({
            x: Math.random() * width,
            y: Math.random() * height,
            vx: (Math.random() - 0.5) * 1.2,
            vy: (Math.random() - 0.5) * 1.2
        }));

        const columns = Math.floor(window.innerWidth / 22);
        const drops = Array(columns).fill(1);
        let timeFrame = 0;

        function renderCanvas() {
            const theme = document.body.className;
            let compStyle = window.getComputedStyle(document.body);
            let accent = compStyle.getPropertyValue('--accent-primary').trim() || '#38bdf8';

            if (theme.includes('matrix')) {
                ctx.fillStyle = 'rgba(2, 10, 2, 0.12)';
                ctx.fillRect(0, 0, width, height);
                ctx.fillStyle = accent;
                ctx.font = '14px monospace';
                for (let i = 0; i < drops.length; i++) {
                    const char = String.fromCharCode(Math.random() * 128);
                    ctx.fillText(char, i * 22, drops[i] * 22);
                    if (drops[i] * 22 > height && Math.random() > 0.975) drops[i] = 0;
                    drops[i]++;
                }
            } else if (theme.includes('synthwave')) {
                ctx.clearRect(0, 0, width, height);
                ctx.strokeStyle = accent;
                ctx.lineWidth = 1.2;
                ctx.beginPath();
                for (let y = height / 2; y < height; y += (y - height / 2) * 0.12 + 2) {
                    let moveY = y + (timeFrame % 25);
                    if (moveY > height) continue;
                    ctx.moveTo(0, moveY); ctx.lineTo(width, moveY);
                }
                for (let x = -width; x < width * 2; x += 90) {
                    ctx.moveTo(width / 2, height / 2); ctx.lineTo(x, height);
                }
                ctx.stroke();
            } else {
                ctx.clearRect(0, 0, width, height);
                ctx.fillStyle = accent;
                ctx.lineWidth = 0.5;

                for (let i = 0; i < particles.length; i++) {
                    let p = particles[i];
                    p.x += p.vx; p.y += p.vy;
                    if (p.x < 0 || p.x > width) p.vx *= -1;
                    if (p.y < 0 || p.y > height) p.vy *= -1;

                    ctx.beginPath(); ctx.arc(p.x, p.y, 2.2, 0, Math.PI * 2); ctx.fill();

                    for (let j = i + 1; j < particles.length; j++) {
                        let p2 = particles[j];
                        let dx = p.x - p2.x, dy = p.y - p2.y;
                        let dist = Math.sqrt(dx * dx + dy * dy);
                        if (dist < 90) {
                            ctx.strokeStyle = accent;
                            ctx.globalAlpha = 1 - (dist / 90);
                            ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(p2.x, p2.y); ctx.stroke();
                            ctx.globalAlpha = 1.0;
                        }
                    }
                }
            }

            timeFrame++;
            requestAnimationFrame(renderCanvas);
        }

        function initApp() {
            audio.volume = 0.3;
            startThemeTimer();
            renderCanvas();
            console.log("CYBS 4305 Master App Loaded Successfully.");
        }
    </script>
